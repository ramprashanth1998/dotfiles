# Create a new worktree and branch from within current git directory.
if [[ -z "$1" ]]; then
  echo "Usage: ga [branch name]"
  return 1
fi

local branch="$1"
local base="${PWD:t}"
local wt_path="../$base--$branch"

git worktree add -b "$branch" "$wt_path" || return 1
mise trust "$wt_path"
cd "$wt_path"
