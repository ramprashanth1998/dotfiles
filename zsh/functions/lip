# List active SSH port forwards started with fip
#
# macOS pgrep has no -a, so pull the full command line out of ps instead.
local -a pids
pids=(${(f)"$(pgrep -f 'ssh.*-L [0-9]*:localhost:[0-9]*' 2>/dev/null)"})

if (( ${#pids} )); then
  ps -o pid=,command= -p "${(j:,:)pids}"
else
  echo "No active forwards"
fi
