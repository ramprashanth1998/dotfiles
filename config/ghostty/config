# Theme
# Linux pulled colors from ~/.local/state/omarchy/current/theme/ghostty.conf,
# written by Omarchy's theme switcher. Pinned to tokyonight here to match nvim.
theme = tokyonight

# Font
font-family = "CaskaydiaMono Nerd Font"
font-style = Regular
# 11 on the Linux box; Retina wants a couple of points more.
font-size = 14

# Window
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never
macos-titlebar-style = tabs

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Make the left Option key send Meta, so Alt-based word motions work in zsh
# and nvim. Right Option stays dead for typing accented characters.
macos-option-as-alt = left

# Keyboard bindings
# Mac keyboards have no Insert key; Cmd-C/Cmd-V are the native bindings and
# need no config. Send Shift+Enter as CSI-u so TUIs (Claude Code's newline,
# among others) can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# NB: async-backend = epoll and gtk-toolbar-style were Linux/Hyprland-only and
# are dropped here.
